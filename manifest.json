{
  "manifest_version": 3,
  "name": "PageLoom",
  "description": "Capture the current web page as a PNG image or PDF, entirely locally.",
  "version": "1.0.0",
  "permissions": ["activeTab", "scripting", "downloads"],
  "action": {
    "default_title": "PageLoom",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
